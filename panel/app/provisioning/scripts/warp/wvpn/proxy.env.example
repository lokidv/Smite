# ─────────────────────────────────────────────────────────────────────────────
# پیکربندیِ خروجیِ پروکسیِ WireGuard (residential/SOCKS/HTTP)
# این فایل را در سرور به /etc/wvpn-proxy.env کپی کنید (chmod 600) تا نصب‌کننده و
# سرویسِ redsocks از آن بخوانند:
#     sudo cp proxy.env.example /etc/wvpn-proxy.env && sudo chmod 600 /etc/wvpn-proxy.env
#
# اگر این فایل موجود باشد، install_wire.sh در پایانِ نصب به‌صورت خودکار
# proxy-egress.sh را اجرا می‌کند و ترافیک از پروکسی خارج می‌شود.
# ─────────────────────────────────────────────────────────────────────────────

# IP پروکسیِ بالادست
PROXY_IP=198.3.27.9

# ⚠️ پورتِ پروکسی — این را باید پر کنید (residential proxy بدون پورت کار نمی‌کند).
PROXY_PORT=

# نوعِ پروکسی: socks5  یا  http-connect
PROXY_TYPE=socks5

# احراز هویتِ پروکسی
PROXY_USER=14aee205b79db
PROXY_PASS=03200cfd09

# اینترفیسِ WireGuard (پیش‌فرض wg0)
WG_NIC=wg0

# پورتِ محلیِ redsocks (معمولاً نیازی به تغییر نیست)
REDSOCKS_LOCAL_PORT=12345
